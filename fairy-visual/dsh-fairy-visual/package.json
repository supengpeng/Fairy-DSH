{
  "name": "dsh-fairy-visual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "dsh-fairy-contracts": "link:../../fairy-contracts"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "bundle": "tsdown && cp lib/index.iife.js lib/client.js.tmp && mv -f lib/client.js.tmp lib/client.js && cp src/index.js lib/index.js.tmp && mv -f lib/index.js.tmp lib/index.js",
    "test": "node --test test/*.test.js",
    "verify:build": "node ../../fairy-system/verify-build.js",
    "watch": "tsdown --watch"
  }
}
